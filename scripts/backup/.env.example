# The backup job's environment. Server-side only — a developer laptop needs none of this.
# Copy to a file the cron entry reads, and keep it outside the repository.

# The dump must be taken by a role row-level security does NOT filter, or it succeeds and contains
# no tenant rows. This is the migration superuser, never clinic_os_app.
BACKUP_DATABASE_URL=postgresql://clinic_os:changeme@postgres:5432/clinic_os

# The directory the API writes attachments to. pg_dump does not cover it.
ATTACHMENTS_STORAGE_ROOT=/var/lib/clinic-os/attachments

# The age PUBLIC key. The server needs only this — it can encrypt a backup and cannot read one.
# Generate with `age-keygen`, keep the private half off this machine and out of the backup bucket.
BACKUP_AGE_RECIPIENT=age1...

# Any S3-compatible object store. The provider is not chosen yet; see docs/PILOT-READINESS.md item 2a.
BACKUP_S3_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
BACKUP_S3_BUCKET=clinic-os-backups
BACKUP_S3_REGION=eu-central-003
BACKUP_S3_PREFIX=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Where artefacts are staged before upload. Needs room for one dump plus one attachment archive.
BACKUP_WORK_DIR=/tmp

# --- restore-drill.mjs only ---------------------------------------------------------------------
# The drill needs the age PRIVATE key, which the backup job deliberately does not have. Wherever
# this file lives is where a backup can be read, so it decides what the encryption still protects.
BACKUP_AGE_IDENTITY_FILE=/etc/clinic-os/backup-identity.txt

# Superuser, pointed at any database on the cluster: the drill swaps in its own scratch name, which
# it creates and drops on every run.
DRILL_DATABASE_URL=postgresql://clinic_os:changeme@postgres:5432/postgres
DRILL_DATABASE_NAME=clinic_os_restore_drill

# What the restore is compared against — the live database and the live attachments directory.
SOURCE_DATABASE_URL=postgresql://clinic_os:changeme@postgres:5432/clinic_os
SOURCE_ATTACHMENTS_ROOT=/var/lib/clinic-os/attachments

# The application role, so the drill can prove RLS survived the restore. Same swap as above.
DRILL_APP_DATABASE_URL=postgresql://clinic_os_app:changeme@postgres:5432/postgres

DRILL_WORK_DIR=/tmp
