model Payment {
  id                      String              @id @db.Uuid
  tenantId                String              @map("tenant_id") @db.Uuid
  patientId               String              @map("patient_id") @db.Uuid
  appointmentId           String?             @map("appointment_id") @db.Uuid
  visitId                 String?             @map("visit_id") @db.Uuid
  /// Phase 5 PR 5: a receipt, not an invoice. Price, discount and amount-due moved to
  /// `visit_charges`; what is left is one money movement.
  amountMinor             Int                 @default(0) @map("amount_minor")
  /// Sequential and gapless per clinic, allocated by a trigger inside the writing transaction.
  receiptNumber           Int                 @default(dbgenerated()) @map("receipt_number")
  receiptDate             DateTime            @default(dbgenerated()) @map("receipt_date") @db.Date
  /// The charge this settles. NULLABLE by ruling: a payment can arrive before the invoice (Q19).
  chargeId                String?             @map("charge_id") @db.Uuid
  method                  PaymentMethod
  status                  PaymentStatus
  collectedByUserId       String?             @map("collected_by_user_id") @db.Uuid
  paidAt                  DateTime?           @map("paid_at") @db.Timestamptz(6)
  notes                   String?
  confirmationMethod      ConfirmationMethod? @map("confirmation_method")
  patientClaimAt          DateTime?           @map("patient_claim_at") @db.Timestamptz(6)
  patientClaimEvidenceUrl String?             @map("patient_claim_evidence_url")
  confirmedByUserId       String?             @map("confirmed_by_user_id") @db.Uuid
  confirmedAt             DateTime?           @map("confirmed_at") @db.Timestamptz(6)
  createdAt               DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant          Tenant              @relation(fields: [tenantId], references: [id])
  patient         Patient             @relation(fields: [patientId], references: [id])
  charge          VisitCharge?        @relation(fields: [chargeId], references: [id])
  appointment     Appointment?        @relation(fields: [appointmentId], references: [id])
  visit           Visit?              @relation(fields: [visitId], references: [id])
  collectedByUser User?               @relation("PaymentCollectedBy", fields: [collectedByUserId], references: [id])
  confirmedByUser User?               @relation("PaymentConfirmedBy", fields: [confirmedByUserId], references: [id])
  adjustments     PaymentAdjustment[]
  creditsCreated  PatientCredit[]

  @@index([tenantId, status])
  @@index([tenantId, patientId])
  @@map("payments")
}

// Append-only (D5).
model PaymentAdjustment {
  id             String         @id @db.Uuid
  tenantId       String         @map("tenant_id") @db.Uuid
  paymentId      String         @map("payment_id") @db.Uuid
