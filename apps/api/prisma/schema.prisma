model PrescriptionItem {
  id             String   @id @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  prescriptionId String   @map("prescription_id") @db.Uuid
  medicationName String   @map("medication_name")
  /// Q45 split the line as an Egyptian prescription is written: strength and form identify the
  /// product, dose and frequency are the instructions, quantity is what the pharmacist dispenses.
  strength       String?
  form           String?
  quantity       String?
  dose           String
  frequency      String
  duration       String
  instructions   String?
  sortOrder      Int      @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  prescription Prescription @relation(fields: [prescriptionId], references: [id])

  @@index([tenantId, prescriptionId])
  @@map("prescription_items")
}

/// What was done at a visit, and what it cost at the moment it was recorded. PHASE-4.md Q25.
///
/// unitPriceMinor is NULLABLE and means "no price was recorded", never zero -- the same reading
/// appointments.quoted_price_minor carries, and for the same reason: the only value available to
/// invent is today's services.price_minor, which would assert a charge nobody made.
model VisitProcedure {
  id               String          @id @db.Uuid
  tenantId         String          @map("tenant_id") @db.Uuid
  visitId          String          @map("visit_id") @db.Uuid
  serviceId        String          @map("service_id") @db.Uuid
  quantity         Int             @default(1)
  unitPriceMinor   Int?            @map("unit_price_minor")
  source           ProcedureSource
  recordedByUserId String          @map("recorded_by_user_id") @db.Uuid
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant         Tenant  @relation(fields: [tenantId], references: [id])
  visit          Visit   @relation(fields: [visitId], references: [id])
  service        Service @relation(fields: [serviceId], references: [id])
  recordedByUser User    @relation(fields: [recordedByUserId], references: [id])

  // A PARTIAL UNIQUE INDEX on (visit_id) WHERE source = 'RECEPTION' exists on this table and is not
  // expressible here -- @@unique has no WHERE clause. It lives in 20260908130000_visit_procedures,
  // mirrored at prisma/sql/26-visit-procedures.sql.
  @@index([tenantId, visitId])
  @@map("visit_procedures")
}

/// One investigation requested at a visit. PHASE-4.md Q24.
/// Ordered by `sortOrder` for the same reason `prescription_items` is: the list has an intent.
model VisitInvestigation {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  visitId   String   @map("visit_id") @db.Uuid
  /// Free text, stored byte-identical. Clinical content is never normalised.
  name      String
  notes     String?
  sortOrder Int      @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  visit  Visit  @relation(fields: [visitId], references: [id])

  @@index([tenantId, visitId])
  @@map("visit_investigations")
}

