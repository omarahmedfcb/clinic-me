  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant         Tenant @relation(fields: [tenantId], references: [id])
  grantedToUser  User   @relation("AccessGrantGrantedTo", fields: [grantedToUserId], references: [id])
  approvedByUser User   @relation("AccessGrantApprovedBy", fields: [approvedByUserId], references: [id])

  @@index([tenantId])
  @@map("access_grants")
}

