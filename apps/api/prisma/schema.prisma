// Append-only (D5).
model AuditLog {
  id            String      @id @db.Uuid
  tenantId      String?     @map("tenant_id") @db.Uuid
  actorUserId   String      @map("actor_user_id") @db.Uuid
  actorRole     String      @map("actor_role")
  action        AuditAction
  entityType    String      @map("entity_type")
  entityId      String      @map("entity_id") @db.Uuid
  previousState Json?       @map("previous_state")
  newState      Json?       @map("new_state")
  ipAddress     String      @map("ip_address")
  userAgent     String      @map("user_agent")
  // The WhatsApp message that triggered this action, for a write made by the AI agent
  // (ARCHITECTURE.md §12 rule 3). A real column rather than a key inside `newState`: it is a
  // foreign key with referential integrity, it is indexable, and "which actions did this message
  // cause" is a question an incident review will actually ask. NULL for every action with a human
  // behind it, which is all of them until Phase 7.
  //
  // WRITES only, by decision rather than by omission. §12 rule 3 originally read "every tool call
  // is written to audit_logs", which was already false: D16's triggers fire on INSERT/UPDATE/
  // DELETE, so find_available_slots() has never left a row. Amended 2026-08-28 to "every tool call
  // that writes" -- auditing every availability lookup would outnumber the appointments themselves,
  // for a read that discloses nothing a patient could not learn by phoning the clinic.
  messageId     String?     @map("message_id") @db.Uuid
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  // onDelete: Restrict is explicit because Prisma's default for an optional relation is SetNull,
  // and SetNull is an UPDATE, which the D5 append-only trigger refuses unconditionally. Leaving
  // the default in place made deleting a tenant fail with "Table audit_logs is append-only"
  // instead of a foreign-key violation. See SCHEMA-DECISIONS.md D18. The same reasoning applies
  // to `message` below, and for the same reason it is spelled out rather than defaulted.
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  actorUser User     @relation(fields: [actorUserId], references: [id])
  message   Message? @relation(fields: [messageId], references: [id], onDelete: Restrict)

  @@index([tenantId, entityType, entityId])
  @@index([tenantId, createdAt])
  @@index([messageId])
  @@map("audit_logs")
}

model Consent {
  id               String         @id @db.Uuid
  tenantId         String         @map("tenant_id") @db.Uuid
  patientId        String         @map("patient_id") @db.Uuid
  purpose          ConsentPurpose
  granted          Boolean
  grantedAt        DateTime       @map("granted_at") @db.Timestamptz(6)
  withdrawnAt      DateTime?      @map("withdrawn_at") @db.Timestamptz(6)
  capturedByUserId String         @map("captured_by_user_id") @db.Uuid
  evidence         Json
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant         Tenant  @relation(fields: [tenantId], references: [id])
  patient        Patient @relation(fields: [patientId], references: [id])
  capturedByUser User    @relation(fields: [capturedByUserId], references: [id])

  @@index([tenantId])
  @@map("consents")
}

/// One clinic's WhatsApp bot credential. docs/WHATSAPP-BOT-CONTRACT.md §2.
model BotCredential {
  id              String    @id @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  /// The AI_AGENT membership this credential authenticates as: the capability set lives there.
  membershipId    String    @map("membership_id") @db.Uuid
  /// Argon2id of the secret. The secret is shown once, at issue, and is never stored.
  secretHash      String    @map("secret_hash")
  issuedByUserId  String    @map("issued_by_user_id") @db.Uuid
  issuedAt        DateTime  @default(now()) @map("issued_at") @db.Timestamptz(6)
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedByUserId String?   @map("revoked_by_user_id") @db.Uuid
  lastUsedAt      DateTime? @map("last_used_at") @db.Timestamptz(6)
  /// HTTPS only, enforced by a CHECK: a reminder over plain HTTP is readable by every hop.
  webhookUrl      String?   @map("webhook_url")
  /// Stored as it is used, like a TOTP secret: we sign with it, so there is nothing to compare to.
  webhookSecret   String?   @map("webhook_secret")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  membership Membership @relation(fields: [membershipId], references: [id])
  issuedBy   User       @relation("BotCredentialIssuer", fields: [issuedByUserId], references: [id])

  @@index([tenantId])
  @@map("bot_credentials")
}

/// One thing the bot is owed. docs/WHATSAPP-BOT-CONTRACT.md §6.
///
/// Written by a database trigger on `appointment_events`, delivered later by
/// `scripts/webhook-dispatch.mjs`. The id is the idempotency key the delivery carries.
model WebhookDelivery {
  id            String    @id @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  appointmentId String    @map("appointment_id") @db.Uuid
  eventType     String    @map("event_type")
  occurredAt    DateTime  @map("occurred_at") @db.Timestamptz(6)
  /// The act that caused it. Null for a reminder, which no act causes.
  sourceEventId String?   @map("source_event_id") @db.Uuid
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @map("next_attempt_at") @db.Timestamptz(6)
  deliveredAt   DateTime? @map("delivered_at") @db.Timestamptz(6)
  failedAt      DateTime? @map("failed_at") @db.Timestamptz(6)
  /// NO_CONSENT, NO_WEBHOOK or PATIENT_GONE: why nothing was sent, when nothing was sent.
  skippedReason String?   @map("skipped_reason")
  lastStatus    Int?      @map("last_status")
  lastError     String?   @map("last_error")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant      Tenant            @relation(fields: [tenantId], references: [id])
  appointment Appointment       @relation(fields: [appointmentId], references: [id])
  sourceEvent AppointmentEvent? @relation(fields: [sourceEventId], references: [id])

  @@index([tenantId])
  @@map("webhook_deliveries")
}

model AccessGrant {
  id               String   @id @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  grantedToUserId  String   @map("granted_to_user_id") @db.Uuid
