  overageMinor     Int           @default(0) @map("overage_minor")
  discountMinor    Int           @default(0) @map("discount_minor")
  taxMinor         Int           @default(0) @map("tax_minor")
  totalMinor       Int           @map("total_minor")
  status           InvoiceStatus
  issuedAt         DateTime?     @map("issued_at") @db.Timestamptz(6)
  dueAt            DateTime      @map("due_at") @db.Timestamptz(6)
  paidAt           DateTime?     @map("paid_at") @db.Timestamptz(6)
  paymentReference String?       @map("payment_reference")
  etaSubmissionId  String?       @map("eta_submission_id")
  etaStatus        String?       @map("eta_status")
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  subscription Subscription @relation(fields: [subscriptionId], references: [id])

  // @@unique([tenantId, invoiceNumber]) already covers tenantId-only lookups (leftmost prefix) — no bare index added.
  @@unique([tenantId, invoiceNumber])
  @@map("invoices")
}

