  lastMessageAt          DateTime?          @map("last_message_at") @db.Timestamptz(6)
  openedAt               DateTime           @map("opened_at") @db.Timestamptz(6)
  closedAt               DateTime?          @map("closed_at") @db.Timestamptz(6)
  assignedToUserId       String?            @map("assigned_to_user_id") @db.Uuid
  createdAt              DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant         Tenant    @relation(fields: [tenantId], references: [id])
  contact        Contact   @relation(fields: [contactId], references: [id])
  assignedToUser User?     @relation(fields: [assignedToUserId], references: [id])
  messages       Message[]

  // @@unique([tenantId, externalConversationId]) already covers tenantId-only lookups — no bare index added.
  @@unique([tenantId, externalConversationId])
  @@map("conversations")
}

model Message {
  id                String           @id @db.Uuid
  tenantId          String           @map("tenant_id") @db.Uuid
  conversationId    String           @map("conversation_id") @db.Uuid
  contactId         String           @map("contact_id") @db.Uuid
  direction         MessageDirection
  messageType       MessageType      @map("message_type")
  externalMessageId String           @map("external_message_id")
  templateId        String?          @map("template_id") @db.Uuid
  // Never clinical content — truncated preview only.
  bodyPreview       String?          @map("body_preview") @db.VarChar(280)
  mediaUrl          String?          @map("media_url")
  status            MessageStatus
  failureReason     String?          @map("failure_reason")
  billable          Boolean
  billingCategory   MessageCategory  @map("billing_category")
  sentAt            DateTime         @map("sent_at") @db.Timestamptz(6)
  deliveredAt       DateTime?        @map("delivered_at") @db.Timestamptz(6)
  readAt            DateTime?        @map("read_at") @db.Timestamptz(6)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant       Tenant           @relation(fields: [tenantId], references: [id])
  conversation Conversation     @relation(fields: [conversationId], references: [id])
  contact      Contact          @relation(fields: [contactId], references: [id])
  template     MessageTemplate? @relation(fields: [templateId], references: [id])
  // Every action the AI agent took because of this message (§12 rule 3). ON DELETE RESTRICT on
  // the audit side means a message that caused an audited action can no longer be deleted, which
  // is the correct direction for an append-only trail: the evidence outlives the convenience.
  auditLogs    AuditLog[]

  @@unique([tenantId, externalMessageId])
  @@index([tenantId, conversationId, createdAt])
  @@map("messages")
}

model MessageTemplate {
  id                   String                 @id @db.Uuid
  tenantId             String?                @map("tenant_id") @db.Uuid // null = platform-wide
  name                 String
  externalTemplateName String                 @map("external_template_name")
  language             String
  category             MessageCategory
  bundles              String[]
  body                 String
  variables            Json
  metaApprovalStatus   TemplateApprovalStatus @map("meta_approval_status")
  approvedAt           DateTime?              @map("approved_at") @db.Timestamptz(6)
  isActive             Boolean                @default(true) @map("is_active")
  createdAt            DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant?   @relation(fields: [tenantId], references: [id])
  messages Message[]

  @@index([tenantId])
  @@map("message_templates")
}

model FollowupTask {
  id                     String         @id @db.Uuid
  tenantId               String         @map("tenant_id") @db.Uuid
  patientId              String         @map("patient_id") @db.Uuid
  doctorId               String         @map("doctor_id") @db.Uuid
  visitId                String         @map("visit_id") @db.Uuid
  treatmentPlanId        String?        @map("treatment_plan_id") @db.Uuid
  dueDate                DateTime       @map("due_date") @db.Date
  status                 FollowupStatus
  attempts               Int            @default(0)
  sentAt                 DateTime?      @map("sent_at") @db.Timestamptz(6)
  respondedAt            DateTime?      @map("responded_at") @db.Timestamptz(6)
  resultingAppointmentId String?        @map("resulting_appointment_id") @db.Uuid
  expiresAt              DateTime       @map("expires_at") @db.Timestamptz(6)
  createdAt              DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant               Tenant         @relation(fields: [tenantId], references: [id])
  patient              Patient        @relation(fields: [patientId], references: [id])
  doctor               Doctor         @relation(fields: [doctorId], references: [id])
  visit                Visit          @relation(fields: [visitId], references: [id])
  treatmentPlan        TreatmentPlan? @relation(fields: [treatmentPlanId], references: [id])
  resultingAppointment Appointment?   @relation(fields: [resultingAppointmentId], references: [id])

  @@index([tenantId, status, dueDate])
  @@map("followup_tasks")
}

// ============================================================================
// Auth — refresh tokens (NOT tenant-scoped — belongs to global user identity)
// ============================================================================

model RefreshToken {
  id            String    @id @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  membershipId  String?   @map("membership_id") @db.Uuid
  tokenHash     String    @unique @map("token_hash")
  familyId      String    @map("family_id") @db.Uuid
  parentTokenId String?   @map("parent_token_id") @db.Uuid
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedReason String?   @map("revoked_reason")
  ipAddress     String    @map("ip_address")
  userAgent     String    @map("user_agent")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user        User           @relation(fields: [userId], references: [id])
  membership  Membership?    @relation(fields: [membershipId], references: [id])
  parentToken RefreshToken?  @relation("RefreshTokenLineage", fields: [parentTokenId], references: [id])
  childTokens RefreshToken[] @relation("RefreshTokenLineage")

  @@index([userId, familyId])
  @@map("refresh_tokens")
}

// ============================================================================
// Attachments — tenant-scoped, RLS-protected, never hard-deleted
// ============================================================================

/**
 * A notification. Its own table rather than a view over `audit_logs` — PHASE-2.md §16.
 * Four reasons in short: `audit_logs` is append-only so read state cannot live there; it is written
 * by a trigger that knows a row changed but not *why* (a reschedule and a cancellation are both
 * UPDATE on appointments); its JSONB snapshots carry clinical content; and its retention is a
 * compliance question while notifications are prunable UI state.
 * Written by the appointments service in the SAME transaction as the change it describes, so a
 * booking that rolls back cannot leave a notification claiming it happened.
 */
model Notification {
  id            String            @id @db.Uuid
  tenantId      String            @map("tenant_id") @db.Uuid
  kind          NotificationKind
  appointmentId String?           @map("appointment_id") @db.Uuid
  patientId     String?           @map("patient_id") @db.Uuid
  actorUserId   String            @map("actor_user_id") @db.Uuid
  /**
   * Where the change came from — reception, the doctor, or the WhatsApp agent.
   */
  source        AppointmentSource
  occurredAt    DateTime          @map("occurred_at") @db.Timestamptz(6)
  /**
   * Only what the list renders: a patient's display name, a time. NEVER clinical content — this is
   * read by reception, and CLAUDE.md separates clinical content by endpoint and DTO rather than by
   * remembering to leave it out.
   */
  payload       Json
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant      Tenant             @relation(fields: [tenantId], references: [id])
  appointment Appointment?       @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  patient     Patient?           @relation(fields: [patientId], references: [id], onDelete: Restrict)
  actorUser   User               @relation(fields: [actorUserId], references: [id])
  reads       NotificationRead[]

  @@index([tenantId, occurredAt])
  @@map("notifications")
}

/**
 * Who has read what. **Per membership, not per user.**
 * A person can hold memberships in two clinics (§4 — the seeded دينا does), so per-user read state
 * would mark a notification read at one clinic by reading it at the other.
 * A table rather than a column on `notifications`, because one notification has many recipients —
 * reception, admin and the doctor may all see one booking — and a single column cannot hold three
 * people's read state.
 */
model NotificationRead {
  id             String   @id @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  notificationId String   @map("notification_id") @db.Uuid
  membershipId   String   @map("membership_id") @db.Uuid
  readAt         DateTime @default(now()) @map("read_at") @db.Timestamptz(6)

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Restrict)
  membership   Membership   @relation(fields: [membershipId], references: [id], onDelete: Restrict)

  @@unique([notificationId, membershipId])
  @@index([tenantId, membershipId])
  @@map("notification_reads")
}

model Attachment {
  id               String             @id @db.Uuid
  tenantId         String             @map("tenant_id") @db.Uuid
  patientId        String             @map("patient_id") @db.Uuid
  visitId          String?            @map("visit_id") @db.Uuid
  uploadedByUserId String             @map("uploaded_by_user_id") @db.Uuid
  fileName         String             @map("file_name")
  storageKey       String             @map("storage_key")
  mimeType         String             @map("mime_type")
  sizeBytes        Int                @map("size_bytes")
  category         AttachmentCategory
  description      String?
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt       DateTime?          @map("archived_at") @db.Timestamptz(6)

  tenant         Tenant  @relation(fields: [tenantId], references: [id])
  patient        Patient @relation(fields: [patientId], references: [id])
  visit          Visit?  @relation(fields: [visitId], references: [id])
  uploadedByUser User    @relation(fields: [uploadedByUserId], references: [id])

  @@index([tenantId, patientId])
  @@map("attachments")
}

/// Kinship between two patients — Q30. Distinct from D28's household, which is a shared phone.
/// Both directions are stored as separate rows, written and deleted as a pair by the service.
model PatientRelation {
  id               String         @id @db.Uuid
  tenantId         String         @map("tenant_id") @db.Uuid
  patientId        String         @map("patient_id") @db.Uuid
  relatedPatientId String         @map("related_patient_id") @db.Uuid
  relation         PatientKinship
  createdByUserId  String         @map("created_by_user_id") @db.Uuid
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant         Tenant  @relation(fields: [tenantId], references: [id])
  patient        Patient @relation("PatientRelationFrom", fields: [patientId], references: [id])
  relatedPatient Patient @relation("PatientRelationTo", fields: [relatedPatientId], references: [id])
  createdByUser  User    @relation(fields: [createdByUserId], references: [id])

  @@unique([patientId, relatedPatientId])
  @@index([tenantId, patientId])
  @@map("patient_relations")
}

enum PatientKinship {
  HUSBAND
  WIFE
  SON
  DAUGHTER
  FATHER
  MOTHER
  /// Used when the reciprocal cannot be derived — the other patient has no recorded sex.
  RELATIVE
}

/// Patient-level clinical content, APPEND-ONLY — PHASE-4.md Q22. Its own table, never columns on
/// `patients`, which reception reads. Allergies stay in `patient_allergies`, the one list.
///
/// Any doctor may add an entry; nobody edits or deletes one. Enforced by a BEFORE UPDATE OR DELETE
/// trigger (D5), not by the service, because a service check passes on a database that never got it.
model PatientClinicalProfileEntry {
  id           String               @id @db.Uuid
  tenantId     String               @map("tenant_id") @db.Uuid
  patientId    String               @map("patient_id") @db.Uuid
  field        ClinicalProfileField
  /// Free text, stored byte-identical. Clinical content is never normalised.
  content      String
  authorUserId String               @map("author_user_id") @db.Uuid
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant     Tenant  @relation(fields: [tenantId], references: [id])
  patient    Patient @relation(fields: [patientId], references: [id])
  authorUser User    @relation(fields: [authorUserId], references: [id])

  @@index([tenantId, patientId, createdAt])
  @@map("patient_clinical_profile_entries")
}

/// Known allergies — asserted, not derived.
///
/// Chronic medication is deliberately NOT modelled here. It is derived from prescription items at
/// query time so that it cannot go stale: a mirrored field would diverge the first time a doctor
/// changed a dose in a prescription without updating the copy, and a stale medication list in a
/// safety summary is worse than an empty one because it will be trusted. See PHASE-4.md.
model PatientAllergy {
  id               String          @id @db.Uuid
  tenantId         String          @map("tenant_id") @db.Uuid
  patientId        String          @map("patient_id") @db.Uuid
  /// Free text, stored byte-identical. Clinical content is never normalised.
  substance        String
  /// Ready for a coded catalogue without a rewrite. NULL until one exists — never invented.
  substanceCode    String?         @map("substance_code")
  codeSystem       String?         @map("code_system")
  reaction         String?
  severity         AllergySeverity
  status           AllergyStatus   @default(ACTIVE)
  notes            String?
  recordedByUserId String          @map("recorded_by_user_id") @db.Uuid
  recordedAt       DateTime        @default(now()) @map("recorded_at") @db.Timestamptz(6)
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant         Tenant  @relation(fields: [tenantId], references: [id])
  patient        Patient @relation(fields: [patientId], references: [id])
  recordedByUser User    @relation(fields: [recordedByUserId], references: [id])

  @@index([tenantId, patientId])
  @@map("patient_allergies")
}

enum AllergySeverity {
  MILD
  MODERATE
  SEVERE
  LIFE_THREATENING
}

enum AllergyStatus {
  ACTIVE
  RESOLVED
  /// Recorded in error. Kept rather than deleted, and excluded from the summary.
  ENTERED_IN_ERROR
}

/// Patient care transfers (PHASE-3.md Q16/Q17/Q21, SCHEMA-DECISIONS.md D24).
///
/// **There is deliberately no expiry column.** A grant is active when `status` is `ACCEPTED` and
/// `now < decidedAt + window`, compared on every read. See D24 before adding a cleanup job.
model PatientTransfer {
  id                      String         @id @db.Uuid
  tenantId                String         @map("tenant_id") @db.Uuid
  patientId               String         @map("patient_id") @db.Uuid
  fromDoctorId            String         @map("from_doctor_id") @db.Uuid
  toDoctorId              String         @map("to_doctor_id") @db.Uuid
  /// The occasion. LAPSED is decided from this appointment's status.
  appointmentId           String         @map("appointment_id") @db.Uuid
  status                  TransferStatus @default(PENDING)
  reason                  String?
  initiatedByMembershipId String         @map("initiated_by_membership_id") @db.Uuid
  decidedByMembershipId   String?        @map("decided_by_membership_id") @db.Uuid
  /// The instant the access window is measured from. NULL exactly while PENDING (CHECK enforced).
  decidedAt               DateTime?      @map("decided_at") @db.Timestamptz(6)
  decisionNote            String?        @map("decision_note")
  createdAt               DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  patient     Patient     @relation(fields: [patientId], references: [id])
  fromDoctor  Doctor      @relation("TransferFrom", fields: [fromDoctorId], references: [id])
  toDoctor    Doctor      @relation("TransferTo", fields: [toDoctorId], references: [id])
  appointment Appointment @relation(fields: [appointmentId], references: [id])
  initiatedBy Membership  @relation("TransferInitiatedBy", fields: [initiatedByMembershipId], references: [id])
  decidedBy   Membership? @relation("TransferDecidedBy", fields: [decidedByMembershipId], references: [id])

  /// The partial unique index (`WHERE status = 'PENDING'`) lives in prisma/sql/19 -- Prisma cannot
  /// express a partial unique constraint, and it is what makes "one open request per patient"
  /// unwinnable rather than merely unlikely.
  @@index([tenantId, status])
  @@index([tenantId, toDoctorId, patientId, status])
  @@index([tenantId, appointmentId])
  @@map("patient_transfers")
}

/// What a completed visit costs -- PHASE-5-DESIGN.md 4.1. Not `Invoice`: that name is taken by
/// SaaS subscription billing, and two unrelated things one word apart is a query waiting to go wrong.
model VisitCharge {
  id                         String       @id @db.Uuid
  tenantId                   String       @map("tenant_id") @db.Uuid
  visitId                    String       @unique @map("visit_id") @db.Uuid
  patientId                  String       @map("patient_id") @db.Uuid
  status                     ChargeStatus @default(OPEN)
  subtotalMinor              Int          @default(0) @map("subtotal_minor")
  discountMinor              Int          @default(0) @map("discount_minor")
  discountReason             String?      @map("discount_reason")
  /// What an insurer or employer is expected to pay. Set by hand: no coverage rate exists (4.2).
  payerShareMinor            Int          @default(0) @map("payer_share_minor")
  /// Who allowed a discount above the ceiling. Null means nobody had to (ruling 4).
  discountAuthorisedByUserId String?      @map("discount_authorised_by_user_id") @db.Uuid
  /// The clinic's ceiling as it stood when this charge was written. A CHECK cannot reach another
  /// table, and raising the ceiling next year must not retroactively authorise an old discount.
  ceilingPercentSnapshot     Int?         @map("ceiling_percent_snapshot")
  ceilingMinorSnapshot       Int?         @map("ceiling_minor_snapshot")
  createdAt                  DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant               Tenant            @relation(fields: [tenantId], references: [id])
  visit                Visit             @relation(fields: [visitId], references: [id])
  patient              Patient           @relation(fields: [patientId], references: [id])
  discountAuthorisedBy User?             @relation("ChargeDiscountAuthorisedBy", fields: [discountAuthorisedByUserId], references: [id])
  lines                VisitChargeLine[]
  payments             Payment[]
  creditsApplied       PatientCredit[]

  /// The patient's share and the balance are NOT columns: they are computed by the
  /// `visit_charge_balances` view (D7 as amended -- database-computed, not necessarily GENERATED).
  @@index([tenantId, status])
  @@map("visit_charges")
}

/// One procedure or material on a charge, with its name and price frozen at completion.
model VisitChargeLine {
  id               String           @id @db.Uuid
  tenantId         String           @map("tenant_id") @db.Uuid
  chargeId         String           @map("charge_id") @db.Uuid
  nameSnapshot     String           @map("name_snapshot")
  unitPriceMinor   Int              @map("unit_price_minor")
  quantity         Int              @default(1)
  source           ChargeLineSource
  /// R1: set on an ADJUSTMENT line only — the doctor who moved the total. The reason and the
  /// instant live on the visit the adjustment was made against.
  adjustedByUserId String?          @map("adjusted_by_user_id") @db.Uuid
  serviceId        String?          @map("service_id") @db.Uuid
  materialId       String?          @map("material_id") @db.Uuid
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant     Tenant              @relation(fields: [tenantId], references: [id])
  charge     VisitCharge         @relation(fields: [chargeId], references: [id])
  service    Service?            @relation(fields: [serviceId], references: [id])
  material   ChargeableMaterial? @relation(fields: [materialId], references: [id])
  adjustedBy User?               @relation("ChargeLineAdjustedBy", fields: [adjustedByUserId], references: [id])

  /// A CHECK keeps `source` in step with which of the two ids is set; see the migration.
  @@index([tenantId, chargeId])
  @@map("visit_charge_lines")
}

/// Materials a visit can be charged for. Deliberately not rows in `services`: a material has no
/// duration and is not bookable, and putting it there gives the slot engine rows to ignore.
model ChargeableMaterial {
  id         String   @id @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  nameAr     String   @map("name_ar")
  nameEn     String?  @map("name_en")
  unit       String
  priceMinor Int      @map("price_minor")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant            @relation(fields: [tenantId], references: [id])
  lines  VisitChargeLine[]

  @@index([tenantId, isActive])
  @@map("chargeable_materials")
}

/// Clinic credit, ruling 5. One row per movement; the balance is a view, never a stored number.
model PatientCredit {
  id              String         @id @db.Uuid
  tenantId        String         @map("tenant_id") @db.Uuid
  patientId       String         @map("patient_id") @db.Uuid
  movement        CreditMovement
  /// Always positive. The direction is the movement — a signed amount invites a sum that nets two
  /// different events, and "never forfeited" has to be readable from the rows.
  amountMinor     Int            @map("amount_minor")
  /// Required for a refund, by CHECK: a refund nobody stated a reason for is one somebody has to
  /// explain a year later.
  reason          String?
  actorUserId     String         @map("actor_user_id") @db.Uuid
  /// Where the credit came from: an unallocated payment, or the part of one that exceeded the bill.
  sourcePaymentId String?        @map("source_payment_id") @db.Uuid
  /// The charge this movement settled.
  appliedChargeId String?        @map("applied_charge_id") @db.Uuid
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant        Tenant       @relation(fields: [tenantId], references: [id])
  patient       Patient      @relation(fields: [patientId], references: [id])
  actorUser     User         @relation(fields: [actorUserId], references: [id])
  sourcePayment Payment?     @relation(fields: [sourcePaymentId], references: [id])
  appliedCharge VisitCharge? @relation(fields: [appliedChargeId], references: [id])

  @@index([tenantId, patientId])
  @@index([tenantId, appliedChargeId])
  @@index([tenantId, sourcePaymentId])
  @@map("patient_credits")
}

enum CreditMovement {
  CREDIT
  APPLIED
  REFUNDED
}

enum ChargeStatus {
  OPEN
  SETTLED
  VOID
}

enum ChargeLineSource {
  CATALOGUE
  AD_HOC
  MATERIAL
  /// R1: a signed line moving the total, written instead of editing a snapshotted one.
  ADJUSTMENT
}
