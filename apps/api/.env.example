# Migration / Prisma CLI connection only (prisma.config.ts). This role is the Postgres
# superuser created from docker-compose's POSTGRES_USER -- it has BYPASSRLS, which means it must
# never be used by the running application, or every RLS policy becomes a no-op.
DATABASE_URL="postgresql://clinic_os:changeme@localhost:5432/clinic_os_dev?schema=public"

# Optional. If unset, `prisma migrate dev` creates and drops a temporary shadow
# database automatically on the same server (requires CREATEDB, which the default
# postgres:16 superuser role has). Only set this to point at a persistent shadow
# database if the connecting role does not have CREATEDB.
# SHADOW_DATABASE_URL="postgresql://clinic_os:changeme@localhost:5432/clinic_os_shadow?schema=public"

# Application runtime connection (apps/api/src/prisma/client.ts, Phase 1 backend-service work).
# clinic_os_app is an ordinary role -- NOSUPERUSER, NOBYPASSRLS -- created by
# prisma/migrations/*_app_role. Row-Level Security is only enforced when the app connects as
# this role, never as the DATABASE_URL superuser role above.
APP_DATABASE_URL="postgresql://clinic_os_app:changeme@localhost:5432/clinic_os_dev?schema=public"

# Integration test suite (apps/api/test/integration/) only. Points at clinic_os_test, a database
# separate from clinic_os_dev (created by docker/postgres-init/01-create-test-database.sql) --
# not truncate-between-tests against the dev database, so a failed run can't leave state that
# makes the next run pass, and a developer poking at the dev DB can't break CI. Same superuser /
# migration-only vs. application-role split as above: TEST_DATABASE_URL runs migrations against
# clinic_os_test; TEST_APP_DATABASE_URL is what the RLS-dependent integration tests connect as.
TEST_DATABASE_URL="postgresql://clinic_os:changeme@localhost:5432/clinic_os_test?schema=public"
TEST_APP_DATABASE_URL="postgresql://clinic_os_app:changeme@localhost:5432/clinic_os_test?schema=public"

# HS256 signing secret for access tokens (apps/api/src/modules/auth/jwt.ts). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Rotating this invalidates every outstanding access token immediately (they're stateless -- no
# revocation list) but not refresh tokens, which are validated against the database, not signed.
JWT_SECRET="changeme"

# HMAC key for slot tokens (apps/api/src/modules/appointments/slot-token.ts). Minimum 32 chars.
# Generate with the same command as JWT_SECRET.
# These tokens are what make ARCHITECTURE.md §12 rule 1 structurally true: booking takes the
# token's values, never the request's, so a time the clinic never offered has no valid token.
# Rotating it invalidates outstanding slot lists -- callers just ask for availability again, and
# the tokens live ten minutes anyway.
SLOT_TOKEN_SECRET="changeme-at-least-32-characters-long"

# Optional. Port the API listens on (apps/api/src/main.ts). Defaults to 3000 when unset.
# PORT=3000

# Optional. The instant the seed builds its world around -- appointments run from 90 days before
# it to 14 days after (apps/api/prisma/seed/blueprint.ts). Unset uses the pinned default, which is
# what makes the seed reproducible; it is deliberately not the current time. Set it to an ISO date
# for a one-off run against a different window, e.g. to get appointments that are still in the
# future once real time has passed the default. An unparseable value is rejected, not ignored.
# SEED_REFERENCE_DATE="2026-08-25T09:00:00Z"

# Where attachment files are stored (apps/api/src/modules/attachments/storage/). REQUIRED --
# there is deliberately no default, because every candidate default is wrong in a way that fails
# silently: a path inside the repository ends up committed by a later `git add -A`, and a temp
# directory is emptied on reboot, taking patient scans with it.
#
# Must be an ABSOLUTE path, outside the repository and outside any directory the web server
# serves. Attachments are streamed through the API under `visits.readContent` (PHASE-4.md Q11) --
# a root Caddy could serve directly would be a doctor-only file with a public URL on it.
#
# This is state on the host that `pg_dump` does not cover. See docs/DEPLOY.md: a backup that
# captures only the database restores a set of attachment rows whose files are all missing.
ATTACHMENTS_STORAGE_ROOT="/srv/clinic-os/attachments"

# Optional. The country libphonenumber-js parses a typed phone number against when no other hint is
# available -- the login identifier, and the clinic's own letterhead numbers. "EG", "SA" or "AE";
# anything else, including unset, means EG. CLAUDE.md forbids assuming +20 in code, which is why
# this is a variable rather than a literal; it is documented here because it had two readers and no
# entry (apps/api/src/modules/auth/auth.controller.ts, modules/clinic-identity).
# DEFAULT_PHONE_COUNTRY="EG"
