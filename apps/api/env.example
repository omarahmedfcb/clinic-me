POSTGRES_USER=clinic_os
POSTGRES_PASSWORD=changeme
POSTGRES_DB=clinic_os_dev
REDIS_PASSWORD=changeme

# The web chat prototype's model (webchat/gpt-client.ts), also reused by the WhatsApp bot.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5-nano
# OPENAI_REASONING_EFFORT=low

# Where the WhatsApp module calls the /bot/* endpoints it authenticates against -- itself, in this
# deployment. http://localhost:3000 is correct for local dev; a real deployment behind a reverse
# proxy still points this at its own address, never at the public one ngrok/Caddy exposes.
API_BASE_URL=http://localhost:3000

# One clinic's bot credential for now (apps/api/src/modules/whatsapp/bot-api-client.ts). Issue one
# with POST /clinic/bot-credential (as an OWNER/ADMIN) and paste its id and secret here -- the secret
# is shown exactly once at issuance and cannot be recovered afterwards.
BOT_CREDENTIAL_ID=
BOT_CREDENTIAL_SECRET=

# Meta / WhatsApp Cloud API (apps/api/src/modules/whatsapp). WHATSAPP_ACCESS_TOKEN sends messages;
# WHATSAPP_APP_SECRET verifies that an inbound webhook really came from Meta
# (whatsapp-signing.ts); WHATSAPP_VERIFY_TOKEN is a value you choose yourself and enter again when
# registering the webhook URL in the Meta dashboard's one-time subscription check.
