{
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://snack-gently-overlabor.ngrok-free.dev/$1",
      "transforms": [
        {
          "type": "request.headers",
          "op": "set",
          "target": { "key": "ngrok-skip-browser-warning" },
          "args": "1"
        }
      ]
    },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
